# Copia este archivo como .env (no se sube a Git)

# Host que los brokers anuncian a los clientes externos (listener EXTERNAL, puertos 9092-9094):
#   en tu Mac: localhost
#   en la EC2 de Kafka: su IP PRIVADA (la usan los microservicios de la EC2 del backend)
KAFKA_ADVERTISED_HOST=localhost

# Heap por nodo (t3.medium de 4 GB: 3 x 512m + 3 x 192m + Kafka UI 256m)
KAFKA_HEAP=512m
ZOOKEEPER_HEAP=192m

# Acceso al panel Kafka UI (http://<host>:8090)
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=<CLAVE_KAFKA_UI>
